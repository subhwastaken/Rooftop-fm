{
  "name": "rooftop-fm",
  "version": "1.0.0",
  "private": true,
  "description": "Rooftop.fm — Shared music & intimate moments, under the same sky",
  "scripts": {
    "dev": "dot_clean -m src 2>/dev/null || true; node server.mjs",
    "build": "dot_clean -m src 2>/dev/null || true; node ./node_modules/next/dist/bin/next build",
    "start": "NODE_ENV=production node server.mjs",
    "lint": "dot_clean -m src 2>/dev/null || true; node ./node_modules/eslint/bin/eslint.js src",
    "typecheck": "dot_clean -m src 2>/dev/null || true; node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "yt-search": "^2.12.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.4",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  }
}
